  <ItemGroup>
    <!-- Author content ships next to the DLL: the loader reads <mod folder>/Parts/... -->
    <None Update="Parts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="preview.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="docs\**\*" CopyToOutputDirectory="Never" />

    <!-- The schema of part.json is the one description of the format: the loader
         validates every part against it and the editor shows the same rules. It is
         embedded into the DLL, because the docs folder does not ship with the mod. -->
    <EmbeddedResource Include="docs\part.schema.json" LogicalName="part.schema.json" />
