# Antenna example: a mast with a rotating dish on top.
# Two objects, so the editor can animate them separately:
#   mast - yaw rotator for the tracking module
#   dish - spins around its own axis
# Metres, Y up, Z forward, origin in the middle of the mast.
v -0.03 -0.5 -0.03
v 0.03 -0.5 -0.03
v 0.03 0.5 -0.03
v -0.03 0.5 -0.03
v -0.03 -0.5 0.03
v 0.03 -0.5 0.03
v 0.03 0.5 0.03
v -0.03 0.5 0.03
v -0.18 0.5 -0.18
v 0.18 0.5 -0.18
v 0.18 0.56 -0.18
v -0.18 0.56 -0.18
v -0.18 0.5 0.18
v 0.18 0.5 0.18
v 0.18 0.56 0.18
v -0.18 0.56 0.18
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 1 0
vn 0 -1 0
o mast
f 2//1 1//1 4//1
f 2//1 4//1 3//1
f 5//2 6//2 7//2
f 5//2 7//2 8//2
f 1//3 5//3 8//3
f 1//3 8//3 4//3
f 6//4 2//4 3//4
f 6//4 3//4 7//4
f 4//5 8//5 7//5
f 4//5 7//5 3//5
f 1//6 2//6 6//6
f 1//6 6//6 5//6
o dish
f 10//1 9//1 12//1
f 10//1 12//1 11//1
f 13//2 14//2 15//2
f 13//2 15//2 16//2
f 9//3 13//3 16//3
f 9//3 16//3 12//3
f 14//4 10//4 11//4
