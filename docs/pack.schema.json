{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PartAdder pack.json",
  "description": "Optional metadata for a folder inside Parts/.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Pack id. Defaults to the folder name." },
    "name": { "type": "string", "description": "Display name." },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "enabled": { "type": "boolean", "default": true, "description": "false skips the whole pack." }
  }
}
